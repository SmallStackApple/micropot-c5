# MicroPot-C5 C style.
#
# Matches the existing sources: Linux brace style (function braces on their
# own line, control statements attached), 4-space indent, left-aligned
# pointers, 80 columns.
---
Language: Cpp
BasedOnStyle: LLVM
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 80
BreakBeforeBraces: Linux
PointerAlignment: Left
AlignAfterOpenBracket: Align
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: false
AllowShortLoopsOnASingleLine: false
SortIncludes: false
IndentCaseLabels: false
SpaceBeforeParens: ControlStatements
